# Copy this file to deployment/.env on the control-center host. Do not commit
# the copy: it contains the deployment origin and database location.
CONTROL_PLATFORM_MODE=mock
CONTROL_PLATFORM_HOST=127.0.0.1
CONTROL_PLATFORM_PORT=8081
CONTROL_PLATFORM_ALLOWED_ORIGIN=https://control.example.invalid
CONTROL_PLATFORM_SECURE_COOKIES=1
CONTROL_PLATFORM_WORKERS=1
CONTROL_PLATFORM_DATABASE=/var/lib/pinky-control-center/control.db
CONTROL_PLATFORM_ROS_CONFIG=/etc/pinky-control-center/robots.ros.yaml

# ROS is a T12 prerequisite. These IDs and endpoints are intentionally fixed;
# there is no UI/API setting that can change the domain of either robot.
ROS_DOMAIN_ID_ROBOT_1=12
ROS_DOMAIN_ID_ROBOT_2=13
ROSBRIDGE_URL_ROBOT_1=ws://127.0.0.1:9090
ROSBRIDGE_URL_ROBOT_2=ws://127.0.0.1:9091

# Set this only after the real robot contracts and ROS adapter are installed.
# CONTROL_PLATFORM_MODE=ros
